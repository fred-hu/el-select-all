{
  "name": "el-select-all",
  "version": "0.5.2",
  "description": "带有全部选项的el-select组件",
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "build:travis": "cross-env NODE_ENV=travis vue-cli-service build",
    "build:lib": "vue-cli-service build --target lib --name el-select-all --dest lib src/libs/index.js",
    "test": "vitest run",
    "lint": "vue-cli-service lint",
    "prepublishOnly": "pnpm run build:lib"
  },
  "files": [
    "lib/*.js",
    "src/components",
    "src/libs",
    "CHANGELOG.md"
  ],
  "main": "lib/el-select-all.common.js",
  "unpkg": "lib/el-select-all.umd.min.js",
  "jsdelivr": "lib/el-select-all.umd.min.js",
  "peerDependencies": {
    "element-ui": "^2.13.2",
    "vue": "^2.6.11"
  },
  "devDependencies": {
    "@vitejs/plugin-vue2": "2.3.1",
    "@vue/cli-plugin-babel": "~4.5.0",
    "@vue/cli-plugin-eslint": "~4.5.0",
    "@vue/cli-service": "~4.5.0",
    "@vue/test-utils": "1.3.6",
    "babel-eslint": "^10.1.0",
    "babel-plugin-component": "^1.1.1",
    "core-js": "^3.6.5",
    "cross-env": "^7.0.2",
    "element-ui": "^2.13.2",
    "eslint": "^6.7.2",
    "eslint-plugin-vue": "^6.2.2",
    "jsdom": "22.1.0",
    "vite": "4.5.5",
    "vitest": "0.34.6",
    "vue": "^2.6.11",
    "vue-template-compiler": "^2.6.11"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "babel-eslint"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "license": "MIT",
  "homepage": "https://fred-hu.github.io/el-select-all",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fred-hu/el-select-all.git"
  },
  "bugs": {
    "url": "https://github.com/fred-hu/el-select-all/issues"
  },
  "keywords": [
    "select-all",
    "element-ui",
    "el-select",
    "vue",
    "select",
    "全选"
  ],
  "author": "hufei"
}
